{
  "name": "gojito-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",

  // Create namespaces: `wrangler kv namespace create GOJITO_KV` (+ --preview). Paste IDs below.
  // `npm run verify:deploy` fails while id/preview_id contain REPLACE_ME.
  "kv_namespaces": [
    {
      "binding": "GOJITO_KV",
      "id": "REPLACE_ME_KV_ID",
      "preview_id": "REPLACE_ME_PREVIEW_KV_ID"
    }
  ],

  // Secrets (prod): `wrangler secret put SUPABASE_JWT_SECRET`, `wrangler secret put STRIPE_WEBHOOK_SECRET`, …
  // Local: copy `.dev.vars.example` → `.dev.vars` and fill values.
  "vars": {
    "SUPABASE_URL": "",
    "STRIPE_PRICE_ID_PREMIUM_ANNUAL": ""
  }
}
